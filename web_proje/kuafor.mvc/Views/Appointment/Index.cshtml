@using kuafor.mvc.Models
@model IEnumerable<Appointment>
<h2>Randevular</h2>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Çalışan</th>
            <th scope="col">Tarih</th>
            <th scope="col">#</th>
        </tr>
    </thead>
    <tbody>
        @{
            int index = 1;
        }
        @foreach (var appointment in Model)
        {
            <tr>
                <th scope="row">@index</th>
                <td>@appointment.Employee.Name</td>
                <td>@appointment.AppointmentTime</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@appointment.Id">Sil</a>
                </td>
            </tr>
            index++;
        }
    </tbody>
</table>
<a class="btn btn-success" asp-action="Create">Randevu Al</a>