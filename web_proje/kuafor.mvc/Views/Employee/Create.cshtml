@using kuafor.mvc.Models
@model Employee
<h2>Çalışan Ekle</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>İsim</label>
        <input asp-for="Name" />
    </div>
    <div class="mb-3">
        <label>Uzmanlık</label>
        <input asp-for="Specialty" />
    </div>
    <div class="mb-3">
        <label>Ücret</label>
        <input asp-for="Price" />
    </div>
    <div class="mb-3">
        <label>Müsaitlik</label>
        <input asp-for="IsAvailable" type="checkbox" />
    </div>

    <button type="submit">Ekle</button>
</form>